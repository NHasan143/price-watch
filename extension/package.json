{
  "name": "pricewatch-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome extension: add the product page you are looking at to your PriceWatch shelf",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -b && vite build",
    "lint": "oxlint"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^3.1.90",
    "@fontsource-variable/archivo": "^5.3.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.2"
  }
}
