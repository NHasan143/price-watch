# Copy to extension/.env.local (git-ignored), then rebuild with `npm run build`.
# Where the PriceWatch API and web app run. The defaults match local development.
VITE_API_URL=http://localhost:8080
VITE_APP_URL=http://localhost:5173
# Clerk publishable key (pk_test_...). When unset, the key in frontend/.env.local is used;
# when neither is set, the extension adds products as a guest only.
VITE_CLERK_PUBLISHABLE_KEY=
